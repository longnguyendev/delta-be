HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Next.js frontend (delta-renew) cache refresh. On start, Strapi creates/updates
# the webhook "Frontend revalidate (delta-renew)" (Settings → Webhooks) pointing
# here; comma-separate several frontends.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Sent as `Authorization: Bearer …` on every webhook. Must match
# REVALIDATE_SECRET in the frontend. Generate: openssl rand -hex 32
REVALIDATE_SECRET=
